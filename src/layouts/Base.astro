---
import '../styles/global.css';
import '../styles/experience.css';
const { title = 'Taekwondo para Todos' } = Astro.props;
const links=[
  {label:'Biblioteca',href:'/biblioteca'},
  {label:'Atlas',href:'/atlas'},
  {label:'Currículos',href:'/curriculos'},
  {label:'Meu estudo',href:'/estudos'},
];
const path=Astro.url.pathname.replace(/\/$/,'')||'/';
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content="Plataforma educacional independente de Taekwondo com atlas interativo, currículos e referências documentais."/>
  <meta name="theme-color" content="#f9fafb"/>
  <title>{title}</title>
  <script is:inline>
    (() => {
      const KEY = 'taekwondo-theme';
      let selected = null;
      try {
        const saved = localStorage.getItem(KEY);
        if (saved === 'dark' || saved === 'light') selected = saved;
      } catch { /* Navegação privada / storage indisponível */ }
      const preference = window.matchMedia('(prefers-color-scheme: dark)');
      const effective = () => selected || (preference.matches ? 'dark' : 'light');
      const apply = () => {
        const dark = effective() === 'dark';
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', dark ? '#111c29' : '#f9fafb');
        document.querySelectorAll('[data-theme-toggle]').forEach(button => {
          button.textContent = dark ? '☀' : '☾';
          button.setAttribute('aria-label', dark ? 'Ativar tema claro' : 'Ativar tema escuro');
          button.setAttribute('aria-pressed', String(dark));
          button.setAttribute('title', dark ? 'Mudar para tema claro' : 'Mudar para tema escuro');
        });
      };
      // Executa no <head> antes de o corpo ser desenhado para evitar piscar o tema claro.
      apply();
      document.addEventListener('DOMContentLoaded', () => {
        apply();
        document.querySelectorAll('[data-theme-toggle]').forEach(button =>
          button.addEventListener('click', () => {
            selected = effective() === 'dark' ? 'light' : 'dark';
            try { localStorage.setItem(KEY, selected); } catch { /* preferência só desta página */ }
            apply();
          }),
        );
      });
      const onSystemChange = () => { if (!selected) apply(); };
      if (preference.addEventListener) preference.addEventListener('change', onSystemChange);
      else if (preference.addListener) preference.addListener(onSystemChange);
    })();
  </script>
</head>
<body>
<a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
{import.meta.env.PUBLIC_GLOSSARY_REVIEW==='true'&&<aside class="glossary-review-banner">PRÉVIA LOCAL DO GLOSSÁRIO · conteúdo ainda não aprovado, para conferência.</aside>}
{import.meta.env.PUBLIC_CONTENT_REVIEW==='true'&&<aside class="review-banner">PRÉVIA DE REVISÃO · 108 rascunhos não validados. Traduções e técnicas aguardam revisão humana.</aside>}
<header class="site-header">
  <nav class="shell site-navigation" aria-label="Menu principal">
    <a class="logo" href="/" aria-label="Taekwondo para Todos — página inicial">
      <span class="logo-mark" aria-hidden="true">태</span>
      <span class="logo-name">Taekwondo <b>para Todos</b><small>Conhecimento que conecta.</small></span>
    </a>
    <div class="site-links" id="primary-links">
      {links.map(link=><a href={link.href} class={path===link.href||path.startsWith(link.href+'/')?'active':''}
        aria-current={path===link.href?'page':undefined}>{link.label}</a>)}
    </div>
    <div class="header-actions"><a href="/escolas" class="teacher-link">Área do professor <span aria-hidden="true">↗</span></a>
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="Alternar tema" aria-pressed="false">☾</button>
      <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="primary-links">Menu <span aria-hidden="true">☰</span></button>
    </div>
  </nav>
</header>
<main id="conteudo" tabindex="-1"><slot /></main>
<footer class="site-footer"><div class="shell footer-grid"><div><a href="/" class="footer-brand">Taekwondo <span>para Todos</span></a><p>Aprender, consultar, compartilhar.<br>Um projeto comunitário, gratuito e sem fins lucrativos.</p></div><div class="footer-links"><a href="/biblioteca">Biblioteca</a><a href="/fontes">Fontes e metodologia</a><a href="/escolas">Escolas</a><a href="/aprender">Praticar meus conhecimentos</a><a href="/acervo">Acervo em revisão</a></div><p class="independence-note">Iniciativa independente. Não afiliada nem homologada pela Kukkiwon. Conteúdos e requisitos de graduação podem variar por escola.</p></div></footer>
<script>
  const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const links = document.querySelector<HTMLElement>('#primary-links');
  const closeMenu = () => { menu?.setAttribute('aria-expanded', 'false'); links?.classList.remove('is-open'); };
  menu?.addEventListener('click', () => {
    const open = menu.getAttribute('aria-expanded') !== 'true';
    menu.setAttribute('aria-expanded', String(open)); links?.classList.toggle('is-open', open);
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') { closeMenu(); menu.focus(); }
  });
</script>
</body>
</html>
