---
import { studyDirections, type StudyDirection, type StudyMovement } from '../../data/poomsae-study';

interface Props {
  movements: readonly StudyMovement[];
}

const { movements } = Astro.props;
const lines = [
  { y: 67, left: 'ra1', right: 'da1' },
  { y: 125, left: 'ra2', right: 'da2' },
  { y: 183, left: 'ra3', right: 'da3' },
] as const;

function formatSteps(numbers: readonly number[]) {
  const ranges: { first: number; last: number }[] = [];
  for (const number of numbers) {
    const previous = ranges.at(-1);
    if (previous && previous.last + 1 === number) previous.last = number;
    else ranges.push({ first: number, last: number });
  }
  return ranges.map(({ first, last }) => first === last ? String(first) : `${first}–${last}`).join(', ');
}

const onDirection = (direction: StudyDirection) => formatSteps(
  movements.filter((movement) => movement.direction === direction).map((movement) => movement.number),
);
const axialSteps = formatSteps(
  movements.filter(({ direction }) => direction === 'ga' || direction === 'na').map(({ number }) => number),
);
---

<figure class="study-gallery-panel">
  <svg viewBox="0 0 360 250" role="img" aria-label="Na e Ga formam o eixo central. No diagrama, os três lados Ra ficam à esquerda e os lados Da à direita.">
    <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
      <path d="M180 37V213" opacity=".52" />
      <path d="M175 42L180 37 185 42 M175 208L180 213 185 208" />
      {lines.map(({ y }) => <line x1="52" x2="308" y1={y} y2={y} opacity=".52" />)}
    </g>
    <g fill="currentColor" font-size="12" font-weight="650" text-anchor="middle">
      <text x="180" y="25">Na</text>
      <text x="180" y="233">Ga</text>
      {lines.map(({ y, left, right }) => (
        <>
          <circle cx="180" cy={y} r="5" />
          <text x="85" y={y - 11}>{studyDirections[left].label}</text>
          <text x="275" y={y - 11}>{studyDirections[right].label}</text>
          <text x="85" y={y + 20} font-size="11" font-weight="400">{onDirection(left)}</text>
          <text x="275" y={y + 20} font-size="11" font-weight="400">{onDirection(right)}</text>
        </>
      ))}
    </g>
  </svg>
  <figcaption>
    <strong>Linhas de deslocamento</strong>
    <span>Etapas no eixo central: {axialSteps}. Esquema autoral, sem escala.</span>
  </figcaption>
</figure>
