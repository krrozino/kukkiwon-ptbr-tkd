---
import Base from '../layouts/Base.astro';
import CurriculumApp from '../components/CurriculumApp';
---
<Base title="Currículos de Taekwondo — Taekwondo para Todos">
  <section class="shell section">
    <p class="tag">Aprendizado por graduação</p>
    <h1>O caminho da sua escola, no seu celular</h1>
    <p class="lead">Cada escola organiza suas próprias graduações e conteúdos. Recebeu um currículo do professor? Abra o link enviado para acompanhar requisitos, orientações e demonstrações.</p>
    <CurriculumApp client:load />
  </section>
</Base>
