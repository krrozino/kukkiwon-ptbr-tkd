---
import Base from '../layouts/Base.astro';
import Catalogo from '../components/Catalogo';
---
<Base title="Catálogo — Taekwondo para Todos">
  <section class="shell section">
    <p class="tag">Enciclopédia</p>
    <h1>Catálogo técnico</h1>
    <p>Pesquise termos, técnicas e famílias de movimentos com referências e explicações em português.</p>
    <div class="card"><h2>Explore também o acervo</h2><p>Consulte regiões, bases, golpes e defesas em uma navegação complementar ao catálogo.</p><a class="button" href="/acervo">Abrir o acervo</a></div>
    <Catalogo client:load />
  </section>
</Base>
