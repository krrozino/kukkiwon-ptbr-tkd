{
  "name": "kukkiwon-ptbr-tkd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy:manual": "wrangler deploy",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "content:check": "node scripts/content.mjs",
    "content:sql": "node scripts/content.mjs --sql",
    "validate": "npm run content:check && npm run check && npm test && npm run build",
    "content:review": "node scripts/review-export.mjs",
    "test:integration": "node tools/local-validation/verify.mjs",
    "test:schools": "node tools/local-validation/sprint02.mjs",
    "preview:prepare": "node scripts/prepare-preview.mjs",
    "preview:review": "node scripts/prepare-preview.mjs --review",
    "preview:connected": "node scripts/prepare-preview.mjs --review --connected",
    "preview:pilot": "node scripts/prepare-preview.mjs --connected",
    "preview:external:check": "node tools/local-validation/check-deployed.mjs",
    "preview:check": "node tools/local-validation/check-preview.mjs",
    "glossary:check": "node scripts/glossary.mjs",
    "glossary:preview": "node scripts/glossary-preview.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "@supabase/supabase-js": "2.119.0",
    "astro": "7.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
