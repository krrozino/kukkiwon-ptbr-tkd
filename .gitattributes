# Source bytes are evidence; Git must not rewrite newline sequences on Windows.
content/research/** text eol=lf
content/research/**/original/** -text whitespace=cr-at-eol
# Human findings remain in document-audit.json and the Markdown audit reports.
content/research/**/audit.json linguist-generated=true
content/research/**/inventory.json linguist-generated=true
content/research/**/candidates.csv -text whitespace=cr-at-eol linguist-generated=true
content/research/atlas-hand-v1/claims.csv -text whitespace=cr-at-eol linguist-generated=true
